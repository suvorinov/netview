# Конфигурация NetView.
# Скопируйте в .env и заполните реальные значения:
#   cp .env.example .env
#
# .env не попадает ни в git (.gitignore), ни в Docker-образ (.dockerignore).

# Ключ подписи сессий. Сгенерировать:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
# Если не задан — генерируется случайный, сессии сбрасываются при перезапуске.
SECRET_KEY=

# Учётные записи для входа: user:pass,user2:pass2
# Пароль можно хранить pbkdf2-хешем werkzeug (generate_password_hash).
AUTH_USERS=admin:change-me

# Диапазон DHCP-пула "начало,конец" — признак «В DHCP-пуле» в NetCerber.
# Пусто — признак выключен.
DHCP_POOL=192.168.0.31,192.168.0.199

# URL внутренних сервисов. Внутри контейнера localhost — это сам контейнер,
# поэтому для сервисов на хост-машине используйте host.docker.internal
# (в compose уже добавлен extra_hosts с host-gateway).
PRINTER_API_URL=http://host.docker.internal:8101
HOST_API_URL=http://host.docker.internal:8102
LOGSPY_API_URL=http://host.docker.internal:8103
NETCERBER_API_URL=http://host.docker.internal:8104

# Таймауты запросов к сервисам, сек. У каждого свой дефолт; при
# необходимости — свой PRINTER_TIMEOUT/HOST_TIMEOUT/LOGSPY_TIMEOUT/
# NETCERBER_TIMEOUT.
# LogSpy 60 по умолчанию: сведения о пользователе парсят большой лог
# и могут отвечать дольше 15 с.
PRINTER_TIMEOUT=60
HOST_TIMEOUT=10
LOGSPY_TIMEOUT=60
NETCERBER_TIMEOUT=15

# Домен AD для подстановки в фильтры логов.
AD_DOMAIN=

# Cookie сессии только по HTTPS — включайте, если панель открыта через HTTPS.
# SESSION_COOKIE_SECURE=1

# ── Блокировка на шлюзе OPNsense (TING) по MAC ────────────────
# Единственный контур активного реагирования: алиас MAC + правило
# брандмауэра action=block (source=алиас) в начале списка режут весь
# трафик роугера (интернет и LAN) по MAC — переживает смену IP.
# Требует модуль os-firewall на шлюзе.
OPNSENSE_ENABLED=0
# Ограничение скорости (Traffic Shaper): вопросы — «каналы» шейпера и
# правила в Firewall → Shaper. Управляется отдельно от блокировки,
# креды те же. Запись: addrule/setrule/delrule + service/reconfigure.
OPNSENSE_SHAPER_ENABLED=0
# URL веб-интерфейса шлюза.
OPNSENSE_URL=http://192.168.0.1
# Пара API-ключ:секрет (System → Access → Users → API keys).
OPNSENSE_KEY=
OPNSENSE_SECRET=
# Таймаут запросов к шлюзу, секунды.
OPNSENSE_TIMEOUT=10
# Защищённые MAC через запятую: попытка их заблокировать отклоняется.
# Заполните MAC роутеров/серверов/DHCP-сервера.
OPNSENSE_PROTECTED_MACS=

# Режим отладки (в рабочем контуре не включать: 1/true/yes/on).
DEBUG=0
